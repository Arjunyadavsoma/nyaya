// Nyaya (NyayaAI) — Prisma schema
// SQLite-adapted from the Supabase+pgvector spec.
// Embeddings stored as JSON float[]; FTS via application-layer BM25.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Users & Auth ──────────────────────────────────────────────
model User {
  id            String         @id @default(cuid())
  email         String?        @unique
  phone         String?        @unique
  name          String?
  role          String         @default("viewer") // viewer|editor|legal_reviewer|superadmin
  authProvider  String         @default("guest") // guest|credentials
  passwordHash  String?        // scrypt "salt:hash" — credentials users only
  failedLogins  Int            @default(0) // brute-force counter
  lockedUntil   DateTime?      // lockout expiry
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  bookmarks     Bookmark[]
  chatSessions  ChatSession[]
  feedback      Feedback[]
  reports       ContentReport[]
  profile       Profile?
  sessions      Session[]
}

// ── DB-backed sessions (Stage 0: expiry, rotation, revocation) ──
model Session {
  id          String    @id @default(cuid())
  tokenHash   String    @unique // sha256 of the opaque cookie token
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime  // absolute expiry
  lastSeenAt  DateTime  @default(now())
  revokedAt   DateTime? // set on logout/revocation
  rotatedFrom String?   // previous session id when rotated
  ip          String?
  userAgent   String?

  @@index([userId])
  @@index([expiresAt])
}

model Profile {
  userId                   String   @id
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredLanguage        String   @default("en")
  emergencyContactsJson    String   @default("[]")
  hasConsentedLocation     Boolean  @default(false)
  hasConsentedChatStorage  Boolean  @default(false)
  lastActiveAt             DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

// ── Legal knowledge graph ────────────────────────────────────
model LegalSource {
  id            String          @id @default(cuid())
  name          String
  slug          String          @unique
  type          String // act|code|constitution|judgment|regulation
  jurisdiction  String          @default("india")
  sourceUrl     String
  effectiveDate DateTime?
  createdAt     DateTime         @default(now())
  documents     LegalDocument[]
}

model LegalDocument {
  id         String        @id @default(cuid())
  sourceId   String
  source     LegalSource   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  slug       String        @unique
  title      String
  body       String
  language   String        @default("en")
  status     String        @default("draft") // draft|review|verified|published
  verifiedBy String?
  verifiedAt DateTime?
  version    Int           @default(1)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  chunks     LegalChunk[]
}

model LegalChunk {
  id           String        @id @default(cuid())
  documentId   String
  document     LegalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sectionNo    String?
  actName      String?
  effectiveDate DateTime?
  content      String
  embedding    String // JSON float[] (1024-d shape compat)
  metadataJson String        @default("{}")
  createdAt    DateTime       @default(now())

  @@index([documentId])
  @@index([sectionNo])
}

// ── Rights library ────────────────────────────────────────────
model RightsTopic {
  id          String          @id @default(cuid())
  slug        String          @unique
  title       String
  icon        String?
  description String?
  order       Int             @default(0)
  articles    RightsArticle[]
}

model RightsArticle {
  id                  String      @id @default(cuid())
  topicId             String
  topic               RightsTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  slug                String      @unique
  title               String
  summary             String
  body                String
  actualLaw           String
  example             String?
  whatToDoIfViolated  String?
  language            String      @default("en")
  jurisdiction        String      @default("india")
  sourceUrl           String
  verifiedBy          String?
  verifiedAt          DateTime?
  version             Int         @default(1)
  status              String      @default("draft")
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([topicId])
  @@index([status])
}

// ── Emergency ────────────────────────────────────────────────
model EmergencyScenario {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  icon          String?
  whatToDo      String
  whatToSay     String?
  whatNotToDo   String?
  whatToKeep    String?
  applicableLaw String?
  authority     String?
  offlineCached Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Helpline {
  id           String   @id @default(cuid())
  number       String   @unique
  label        String
  category     String
  description  String?
  available24x7 Boolean @default(true)
  language     String   @default("en")
  order        Int      @default(0)
}

// ── Police stations ───────────────────────────────────────────
model PoliceStation {
  id           String   @id @default(cuid())
  name         String
  address      String
  city         String?
  state        String?
  pincode      String?
  phone        String?
  lat          Float
  lng          Float
  openHours    String?
  jurisdiction String?
  source       String   @default("osm")
  status       String   @default("published")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([state])
  @@index([city])
}

// ── Judges (official info only) ───────────────────────────────
model Judge {
  id                   String   @id @default(cuid())
  name                 String
  courtLevel           String // supreme-court|high-court|district
  state                String?
  courtName            String?
  appointmentYear      Int?
  education            String?
  careerTimeline       String?
  photoUrl             String?
  officialSourceUrl    String
  notableJudgmentsJson String   @default("[]")
  status               String   @default("published")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([courtLevel])
  @@index([state])
}

// ── Supreme Court Judgments (1950–2024) ─────────────────────
model SCJudgment {
  id          String   @id @default(cuid())
  caseName    String
  year        Int?
  dateStr     String?
  source      String   @default("Supreme Court of India")
  sourceUrl   String   @default("https://main.sci.gov.in/judgments")
  status      String   @default("published")
  createdAt   DateTime @default(now())

  @@index([year])
  @@index([caseName])
}

// ── Legal info hub ───────────────────────────────────────────
model LegalInfoArticle {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  body        String
  category    String // procedure|template|locator|glossary
  state       String?
  language    String   @default("en")
  sourceUrl   String?
  status      String   @default("draft")
  verifiedBy  String?
  verifiedAt  DateTime?
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

model DocumentTemplate {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  body        String
  format      String   @default("md")
  category    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Chat ──────────────────────────────────────────────────────
model ChatSession {
  id        String        @id @default(cuid())
  userId    String?
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  mode      String        @default("know-the-law")
  title     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
}

model ChatMessage {
  id            String      @id @default(cuid())
  sessionId     String
  session       ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role          String // user|assistant|system
  content       String
  citationsJson String      @default("[]")
  mode          String?
  helpful       Boolean?
  createdAt     DateTime    @default(now())

  @@index([sessionId])
}

model Citation {
  id         String   @id @default(cuid())
  messageId  String?
  actName    String
  sectionNo  String?
  sourceUrl  String
  verifiedAt DateTime?
  createdAt  DateTime @default(now())
}

// ── User engagement ──────────────────────────────────────────
model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // rights-article|playbook|info|template
  refId     String
  label     String
  createdAt DateTime @default(now())

  @@unique([userId, type, refId])
  @@index([userId])
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  messageId String?
  rating    Int?
  comment   String?
  createdAt DateTime @default(now())
}

model ContentReport {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      String
  refId     String
  reason    String
  status    String   @default("open")
  createdAt DateTime @default(now())

  @@index([status])
}

model ContentReview {
  id          String   @id @default(cuid())
  contentType String
  refId       String
  reviewerId  String?
  action      String
  notes       String?
  createdAt   DateTime @default(now())
}

// ── Admin & ops ───────────────────────────────────────────────
model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  action       String
  entityType   String
  entityId     String?
  metadataJson String   @default("{}")
  createdAt    DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ── AI KeyPool usage persistence ─────────────────────────────
model GroqKeyUsage {
  id          String   @id @default(cuid())
  keyId       String
  model       String
  date        String // YYYY-MM-DD UTC
  requests    Int      @default(0)
  tokens      Int      @default(0)
  lastError   String?
  lastErrorAt DateTime?
  updatedAt   DateTime @updatedAt

  @@unique([keyId, model, date])
  @@index([keyId, date])
}

// ── DB-backed rate limiting (Stage 0 G5: works across instances) ──
model RateLimitHit {
  id         String   @id @default(cuid())
  bucketKey  String // "chat:<ip>" | "login:<email>" | ...
  windowStart DateTime
  count      Int      @default(0)

  @@unique([bucketKey, windowStart])
  @@index([windowStart])
}

// ── Research reports (Stage 3) ────────────────────────────────
model ResearchReport {
  id                 String   @id @default(cuid())
  userId             String
  query              String
  summaryJson        String   @default("{}") // full ResearchReport JSON (capped)
  searchProviderUsed Boolean  @default(false)
  aiGenerated        Boolean  @default(false)
  createdAt          DateTime @default(now())

  @@index([userId, createdAt])
}

// ── Document intelligence (Stage 4) ───────────────────────────
// Private-by-default: every read/write path MUST filter by userId.
model UserDocument {
  id            String   @id @default(cuid())
  userId        String
  title         String
  // Storage key: data/documents/<userId>/<docId>.<ext> — never guessable,
  // never served publicly; downloads authorize against this row.
  storageKey    String   @unique
  originalName  String
  mimeType      String
  sizeBytes     Int
  kind          String   @default("document") // document|image|text
  status        String   @default("uploaded") // uploaded|extracted|analyzed|failed
  extractedText String   @default("")          // machine extraction, capped
  pageCount     Int?
  ocrUsed       Boolean  @default(false)
  // Retention: deletedAt drives purge; null = keep until user deletes.
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  analyses      DocumentAnalysis[]
  versions      DocumentVersion[]
  qa            DocumentQa[]

  @@index([userId, createdAt])
}

// Structured analysis output (one per analysis run).
model DocumentAnalysis {
  id           String   @id @default(cuid())
  documentId   String
  document     UserDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  kind         String // summary|structure
  summary      String   @default("")
  partiesJson  String   @default("[]")
  clausesJson  String   @default("[]")
  datesJson    String   @default("[]")
  risksJson    String   @default("[]")
  aiGenerated  Boolean  @default(false)
  model        String?
  createdAt    DateTime @default(now())

  @@index([documentId, createdAt])
}

// Export/version snapshots of the extracted text (regenerable).
model DocumentVersion {
  id         String   @id @default(cuid())
  documentId String
  document   UserDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  label      String   @default("v1")
  text       String
  createdAt  DateTime @default(now())

  @@index([documentId, createdAt])
}

// Grounded Q&A threads per document.
model DocumentQa {
  id         String   @id @default(cuid())
  documentId String
  document   UserDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  question   String
  answer     String
  aiGenerated Boolean @default(false)
  createdAt  DateTime @default(now())

  @@index([documentId, createdAt])
}

// ── Drafting & citizen workflows (Stage 5) ────────────────────
model UserDraft {
  id           String   @id @default(cuid())
  userId       String
  workflowSlug String   // salary-nonpayment | rental-deposit | ...
  title        String
  answersJson  String   @default("{}") // intake answers
  currentText  String   @default("")   // latest draft body
  status       String   @default("draft") // draft | final | exported
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  versions     DraftVersion[]

  @@index([userId, updatedAt])
}

model DraftVersion {
  id        String   @id @default(cuid())
  draftId   String
  draft     UserDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  label     String   @default("v1")
  text      String
  createdAt DateTime @default(now())

  @@index([draftId, createdAt])
}

// ── Stage 6: knowledge-DB extensions ──────────────────────────
model KnowledgeAmendment {
  id             String   @id @default(cuid())
  legalSourceId  String
  sourceSlug     String
  description    String   // e.g. "Act 34 of 2024 s.12 substituted '…'"
  amendmentDate  DateTime?
  effectiveDate  DateTime?
  gazetteUrl     String?
  createdAt      DateTime @default(now())

  @@index([sourceSlug, amendmentDate])
}

model IngestionRun {
  id           String   @id @default(cuid())
  sourceSlug   String
  kind         String   // act | judgment | guidance
  status       String   @default("running") // running | done | failed
  itemsFound   Int      @default(0)
  itemsAdded   Int      @default(0)
  itemsUpdated Int      @default(0)
  errorText    String?
  startedAt    DateTime @default(now())
  finishedAt   DateTime?

  @@index([sourceSlug, startedAt])
}

// ── Stage 6: verified legal-aid directory (NALSA / SLSA / DLSA) ──
// No fabricated contacts: rows are created only from official sources and
// flagged unverified until reviewed.
model LegalAidBody {
  id            String   @id @default(cuid())
  level         String   // national | state | district
  stateCode     String?  // 2-letter code for states; null for national
  district      String?
  name          String
  helpline      String?
  email         String?
  address       String?
  website       String?
  sourceUrl     String   // where the data came from (provenance)
  verified      Boolean  @default(false) // admin review flag
  verifiedBy    String?
  verifiedAt    DateTime?
  updatedAt     DateTime @updatedAt

  @@index([level, stateCode])
  @@index([verified])
}

// ── My Nyaya: personal legal workspace (Stage 7) ──────────────
// All rows are userId-scoped; every query path filters by owner.
model Matter {
  id          String   @id @default(cuid())
  userId      String
  title       String
  category    String   @default("general") // matches workflow categories
  status      String   @default("open") // open | progress | closed
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  events      MatterEvent[]
  tasks       MatterTask[]

  @@index([userId, updatedAt])
}

model MatterEvent {
  id        String   @id @default(cuid())
  matterId  String
  matter    Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  eventDate DateTime
  kind      String   @default("note") // note | document | draft | research | deadline
  text      String
  createdAt DateTime @default(now())

  @@index([matterId, eventDate])
}

model MatterTask {
  id           String    @id @default(cuid())
  matterId     String
  matter       Matter    @relation(fields: [matterId], references: [id], onDelete: Cascade)
  title        String
  dueDate      DateTime?
  done         Boolean   @default(false)
  doneAt       DateTime?
  reminderSent Boolean   @default(false)
  createdAt    DateTime  @default(now())

  @@index([matterId, dueDate])
  @@index([done, dueDate])
}
